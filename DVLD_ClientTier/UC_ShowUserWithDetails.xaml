<UserControl 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_ClientTier"
             xmlns:uc="clr-namespace:DVLD_ClientTier"
             x:Class="DVLD_ClientTier.UC_ShowUserWithDetails"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1050"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <!-- ScrollViewer لحل مشاكل التكبير والتصغير ومنع تشوه العناصر تماماً -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent">

        <Border Background="#F8FAFC" CornerRadius="16" Padding="25" Margin="15,30,15,15" 
                HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxWidth="900" Height="690" Width="1050">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E0" Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Title Bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="User Comprehensive Profile" FontSize="20" FontWeight="Bold" Foreground="#1A202C" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Person Information Card (كارت الشخص في الأعلى) -->
                <uc:UC_PersonCard x:Name="PersonCard" Grid.Row="1" 
                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,15"/>

                <!-- 3. Login / User Credentials Information Control (تحته مباشرة) -->
                <!-- ملاحظة: إذا كان اسم كارت المستخدم لديك UC_UserCard قم بتغييرها هنا لتطابق ملفه -->

                <uc:UC_ShowUserInfo x:Name="UserCard" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>