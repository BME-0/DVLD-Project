<Page x:Class="DVLD_ClientTier.ManageUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:DVLD_ClientTier"
      mc:Ignorable="d"
      Title="Manage Users Information"
      d:DesignHeight="880" d:DesignWidth="1300"
      Background="#F1F5F9"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Style الأزرار الرئيسية (Blue Primary) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style الأزرار الثانوية (Secondary / Close) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style أزرار العمليات السريعة داخل الجدول -->
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style أزرار الـ Pagination -->
        <Style x:Key="PageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style هيدر الجدول -->
        <Style x:Key="ModernColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <!-- Style صفوف الجدول -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Search -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer & Pagination -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔐" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Users Directory" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Manage system users, login credentials, and account statuses" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                    <Button x:Name="btnAddNewUser" Content="➕ Add New User" Style="{StaticResource PrimaryButtonStyle}" Click="btnAddNewUser_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dashboard Cards (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Users -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👥 Total Users" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblTotalUsersCard" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Active Users -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="✅ Active Users" FontSize="13" FontWeight="SemiBold" Foreground="#10B981"/>
                    <TextBlock x:Name="lblActiveUsersCard" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Inactive Users -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="❌ Inactive Users" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444"/>
                    <TextBlock x:Name="lblInactiveUsersCard" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Added Today -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📅 Today's Users" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB"/>
                    <TextBlock x:Name="lblTodayUsersCard" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Search & Filter Bar Section -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Filter By Dropdown Section -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Text="Filter By:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cbFilterBy" Width="160" Height="34" VerticalContentAlignment="Center" 
                              SelectionChanged="cbFilterBy_SelectionChanged" Padding="8,0" Background="#F8FAFC">
                        <ComboBoxItem Content="None" IsSelected="True"/>
                        <ComboBoxItem Content="User ID"/>
                        <ComboBoxItem Content="Person ID"/>
                        <ComboBoxItem Content="Full Name"/>
                        <ComboBoxItem Content="UserName"/>
                        <ComboBoxItem Content="Is Active"/>
                    </ComboBox>
                </StackPanel>

                <!-- Big Search Box & IsActive ComboBox -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <!-- Standard TextBox for text search -->
                    <TextBox x:Name="txtFilterValue" Height="34" VerticalContentAlignment="Center" 
                             Padding="30,0,10,0" Background="#F8FAFC" BorderBrush="#CBD5E1" 
                             BorderThickness="1" TextChanged="txtFilterValue_TextChanged"
                             PreviewTextInput="txtFilterValue_PreviewTextInput"
                             PreviewKeyDown="txtFilterValue_PreviewKeyDown"/>
                    <TextBlock x:Name="txtSearchIcon" Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="#94A3B8" IsHitTestVisible="False"/>

                    <!-- Dropdown ComboBox for Is Active filter (Hidden by default) -->
                    <ComboBox x:Name="cbIsActiveValue" Height="34" VerticalContentAlignment="Center" 
                              Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                              Padding="8,0" Visibility="Collapsed" SelectionChanged="cbIsActiveValue_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Yes"/>
                        <ComboBoxItem Content="No"/>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. DataGrid Section -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
            </Border.Effect>

            <DataGrid x:Name="dgvUsers" AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      Background="Transparent" BorderThickness="0" SelectionMode="Single"
                      RowBackground="White" AlternatingRowBackground="#F8FAFC">

                <!-- Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu FontSize="13">
                        <MenuItem Icon="👁" Header="Show Details" Click="cmShowDetails_Click"/>
                        <Separator/>
                        <MenuItem Icon="➕" Header="Add New User" Click="cmAddNewUser_Click"/>
                        <MenuItem Icon="✏" Header="Edit User" Click="cmEditUser_Click"/>
                        <MenuItem Icon="🗑" Header="Delete User" Click="cmDeleteUser_Click"/>
                        <Separator/>
                        <MenuItem Icon="🔑" Header="Change Password" Click="cmChangePassword_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- User ID -->
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserID}" Width="100"/>

                    <!-- Person ID -->
                    <DataGridTextColumn Header="Person ID" Binding="{Binding PersonID}" Width="100"/>

                    <!-- Full Name -->
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="250"/>

                    <!-- UserName -->
                    <DataGridTextColumn Header="UserName" Binding="{Binding UserName}" Width="180"/>

                    <!-- Is Active -->
                    <DataGridTextColumn Header="Is Active" Binding="{Binding IsActive}" Width="100">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <!-- لو القيمة True (نشط) يصبح لون الخط أخضر غامق وعريض -->
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="ForestGreen"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>

                                    <!-- لو القيمة False (غير نشط) يصبح لون الخط أحمر -->
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Foreground" Value="Crimson"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁" Style="{StaticResource RowActionButtonStyle}" ToolTip="View Details" Click="cmShowDetails_Click"/>
                                    <Button Content="✏" Style="{StaticResource RowActionButtonStyle}" ToolTip="Edit" Click="cmEditUser_Click"/>
                                    <Button Content="🗑" Style="{StaticResource RowActionButtonStyle}" ToolTip="Delete" Click="cmDeleteUser_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Footer & Pagination Section -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Record Counter & Page Size Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E2E8F0" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Records: " FontSize="13" FontWeight="Medium" Foreground="#475569"/>
                        <TextBlock x:Name="lblRecordsCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- ComboBox لتحديد عدد العناصر بالصفحة -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Page Size:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cbPageSize" Width="60" Height="30" VerticalContentAlignment="Center" 
                              SelectionChanged="cbPageSize_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Pagination Control Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnFirst" Content="⏮" Style="{StaticResource PageButtonStyle}" Margin="2,0" Padding="8,5" Click="btnFirst_Click" ToolTip="First Page"/>
                <Button x:Name="btnPrevious" Content="◀ Previous" Style="{StaticResource PageButtonStyle}" Margin="2,0" Click="btnPrevious_Click"/>

                <!-- مؤشر الصفحة الحالية -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,5" Margin="4,0">
                    <TextBlock x:Name="lblPageInfo" Text="Page 1 of 1" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </Border>

                <Button x:Name="btnNext" Content="Next ▶" Style="{StaticResource PageButtonStyle}" Margin="2,0" Click="btnNext_Click"/>
                <Button x:Name="btnLast" Content="⏭" Style="{StaticResource PageButtonStyle}" Margin="2,0" Padding="8,5" Click="btnLast_Click" ToolTip="Last Page"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="btnClose_Click"/>
        </Grid>
    </Grid>
</Page>