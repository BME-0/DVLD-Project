<UserControl x:Class="DVLD_ClientTier.UC_AddEditUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_ClientTier"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950" Loaded="UserControl_Loaded">

    <Border Background="White" CornerRadius="16" Padding="20" Margin="15" 
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Width="900">
            <!-- العنوان الرئيسي -->
            <TextBlock x:Name="lblTitle" Text="Add New User" FontSize="24" FontWeight="Bold" 
                       Foreground="#1A202C" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- التبويبات (TabControl) لمحاكاة شاشة إضافة وتعديل المستخدم في DVLD -->
            <TabControl x:Name="tcUserInfo" Height="570" Background="White" BorderBrush="#E2E8F0">

                <!-- Tab 1: بيانات الشخص (Personal Info) -->
                <TabItem Header="Personal Info" FontWeight="Bold" Padding="15,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Select Person" FontSize="16" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,10"/>

                            <!-- مكان كارت البحث عن شخص أو اختياره -->
                            <Grid Height="400" Background="#F7FAFC">
                                <local:UC_PersonCardWithFilter x:Name="ctrlPersonCardWithFilter" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </Grid>

                            <!-- زر الانتقال للتبويب التالي -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button x:Name="btnNext" Content="Next &gt;&gt;" Width="100" Height="35" 
                                        Background="#3182CE" Foreground="White" FontWeight="Bold" 
                                        BorderThickness="0" Click="btnNext_Click" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: بيانات الدخول (Login Info) -->
                <TabItem Header="Login Info" FontWeight="Bold" Padding="15,8">
                    <StackPanel Margin="40,20,40,20">

                        <!-- User ID -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="User ID: " FontWeight="Bold" Width="160" Foreground="#4A5568" VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock x:Name="lblUserID" Text="[????]" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>

                        <!-- UserName -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="UserName: " FontWeight="Bold" Width="160" Foreground="#4A5568" VerticalAlignment="Center" FontSize="14"/>
                            <TextBox x:Name="txtUserName" TextChanged="txtUserName_TextChanged" Width="350" Height="36" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <!-- Current Password (يظهر فقط في وضع Update) -->
                        <StackPanel x:Name="pnlCurrentPassword" Orientation="Horizontal" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock Text="Current Password: " FontWeight="Bold" Width="160" Foreground="#4A5568" VerticalAlignment="Center" FontSize="14"/>
                            <Grid Width="350" Height="36">
                                <PasswordBox x:Name="txtCurrentPassword" VerticalContentAlignment="Center" Padding="10,0,35,0"/>
                                <TextBox x:Name="txtVisibleCurrentPassword" VerticalContentAlignment="Center" Padding="10,0,35,0" Visibility="Collapsed"/>
                                <Button x:Name="btnToggleCurrentPassword" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnToggleCurrentPassword_Click">
                                    <TextBlock Text="👁" FontSize="14" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Password / New Password -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock x:Name="lblPasswordTitle" Text="Password: " FontWeight="Bold" Width="160" Foreground="#4A5568" VerticalAlignment="Center" FontSize="14"/>
                            <Grid Width="350" Height="36">
                                <PasswordBox x:Name="txtPassword" VerticalContentAlignment="Center" Padding="10,0,35,0"/>
                                <TextBox x:Name="txtVisiblePassword" VerticalContentAlignment="Center" Padding="10,0,35,0" Visibility="Collapsed"/>
                                <Button x:Name="btnTogglePassword" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnTogglePassword_Click">
                                    <TextBlock Text="👁" FontSize="14" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Confirm Password -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="Confirm Password: " FontWeight="Bold" Width="160" Foreground="#4A5568" VerticalAlignment="Center" FontSize="14"/>
                            <Grid Width="350" Height="36">
                                <PasswordBox x:Name="txtConfirmPassword" VerticalContentAlignment="Center" Padding="10,0,35,0"/>
                                <TextBox x:Name="txtVisibleConfirmPassword" VerticalContentAlignment="Center" Padding="10,0,35,0" Visibility="Collapsed"/>
                                <Button x:Name="btnToggleConfirmPassword" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnToggleConfirmPassword_Click">
                                    <TextBlock Text="👁" FontSize="14" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- IsActive CheckBox -->
                        <CheckBox x:Name="chkIsActive" Content="Is Active" FontWeight="Bold" Foreground="#4A5568" Margin="160,0,0,25" IsChecked="True" FontSize="14"/>

                        <!-- أزرار الرجوع والحفظ -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnBack" Content="&lt;&lt; Back" Width="95" Height="36" Margin="0,0,10,0"
                                    Background="#E2E8F0" Foreground="#2D3748" FontWeight="Bold" 
                                    BorderThickness="0" Click="btnBack_Click" Cursor="Hand"/>

                            <Border CornerRadius="6" ClipToBounds="True" Height="36" Width="110">
                                <Button x:Name="btnSave" Content="Save" 
                                        Background="#3182CE" Foreground="White" FontWeight="Bold" 
                                        BorderThickness="0" Click="btnSave_Click" Cursor="Hand"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Border>
</UserControl>