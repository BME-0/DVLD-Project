<Window x:Class="DVLD_ClientTier.WPF_AddEditUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_ClientTier"
        mc:Ignorable="d"
        Title="Add/Edit User" Height="730" Width="980"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F1F5F9">

    <Grid>
        <!-- استدعاء الـ UserControl الأساسي الذي قمنا بتصميمه بداخل النافذة -->
        <local:UC_AddEditUser x:Name="ctrlAddEditUser" HorizontalAlignment="Center" VerticalAlignment="Center" Loaded="ctrlAddEditUser_Loaded"/>
    </Grid>
</Window>