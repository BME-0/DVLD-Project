<UserControl x:Class="DVLD_ClientTier.UC_PersonCardWithFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_ClientTier"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="650">

    <!-- حاوي رئيسي عرضه 570 بكسل تماماً مثل الكارت ومموضع في المنتصف لضمان التطابق التام -->
    <Grid Width="570" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- الصف الأول: شريط البحث (سيمتد بعرض 570 بكسل تماماً) -->
            <RowDefinition Height="Auto"/>
            <!-- الصف الثاني: كارت الشخص -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① شريط البحث (ComboBox + TextBox) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <!-- عرض قائمة الفلتر -->
                <ColumnDefinition Width="10"/>
                <!-- مسافة فاصلة صغيرة -->
                <ColumnDefinition Width="*"/>
                <!-- مربع البحث يملأ المساحة الباقية ليصل العرض الكلي لـ 570 بكسل -->
            </Grid.ColumnDefinitions>

            <!-- قائمة نوع البحث -->
            <ComboBox x:Name="cbFilterBy" Grid.Column="0" Height="36" VerticalContentAlignment="Center" 
                      SelectionChanged="cbFilterBy_SelectionChanged" Padding="8,0" Background="#F8FAFC">
                <ComboBoxItem Content="Person ID" IsSelected="True"/>
                <ComboBoxItem Content="National No"/>
            </ComboBox>

            <!-- حقل النص للبحث مع أيقونة العدسة -->
            <Grid Grid.Column="2">
                <TextBox x:Name="txtFilterValue" Height="36" VerticalContentAlignment="Center" 
                         Padding="32,0,10,0" Background="#F8FAFC" BorderBrush="#CBD5E1" 
                         BorderThickness="1" TextChanged="txtFilterValue_TextChanged"
                         PreviewTextInput="txtFilterValue_PreviewTextInput"
                         PreviewKeyDown="txtFilterValue_PreviewKeyDown"/>
                <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" 
                           Margin="10,0,0,0" Foreground="#94A3B8" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <!-- ② كارت الشخص (أبعاده 570 متطابقة مع شريط البحث تماماً) -->
        <local:UC_PersonCard x:Name="PersonCard" Grid.Row="1" 
                             Width="570" Height="320" 
                             HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</UserControl>