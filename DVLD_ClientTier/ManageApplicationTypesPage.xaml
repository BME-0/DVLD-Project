<Page x:Class="DVLD_ClientTier.ManageApplicationTypesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="880" d:DesignWidth="1300"
      Title="Manage Application Types"  Loaded="Page_Loaded" Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- العنوان -->
            <RowDefinition Height="Auto"/>
            <!-- شريط البحث -->
            <RowDefinition Height="*"/>
            <!-- الجدول -->
            <RowDefinition Height="Auto"/>
            <!-- الفوتر -->
        </Grid.RowDefinitions>

        <!-- 1. العنوان الرئيسي -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Manage Application Types" FontSize="26" FontWeight="SemiBold" Foreground="#2C3E50"/>
            <TextBlock Text="View and update system application types and fees" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 2. شريط البحث والفلترة -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Search by:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#34495E" Grid.Column="0"/>

                <ComboBox x:Name="cbFilterColumn" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,0,0" SelectionChanged="cbFilterColumn_SelectionChanged">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="ID"/>
                    <ComboBoxItem Content="Application Type"/>
                </ComboBox>

                <TextBox x:Name="txtSearchValue" Grid.Column="3" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="txtSearchValue_TextChanged" Tag="Enter search value..."/>
            </Grid>
        </Border>

        <!-- 3. جدول عرض البيانات (DataGrid) -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="5">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DataGrid x:Name="dgvApplicationTypes" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                      BorderBrush="Transparent" Background="Transparent"
                      AlternatingRowBackground="#FAFCFC" RowHeight="40" FontSize="14">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2980B9"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ApplicationTypeID}" Width="100"/>
                    <DataGridTextColumn Header="Application Type Name" Binding="{Binding ApplicationTypeName}" Width="*"/>
                    <DataGridTextColumn Header="Fees ($)" Binding="{Binding Fees}" Width="150"/>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Application Type" Click="EditApplicationType_Click" Icon="✏"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <!-- 4. الفوتر (إجمالي السجلات) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Border Background="#EAECEE" CornerRadius="6" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Applications: " FontSize="14" FontWeight="SemiBold" Foreground="#34495E"/>
                    <TextBlock x:Name="lblCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#2980B9" Margin="5,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>