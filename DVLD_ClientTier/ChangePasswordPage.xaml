<Page x:Class="DVLD_ClientTier.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DVLD_ClientTier"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="800"
      Title="Change Password"
      Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- البورد الرئيسي الكبير الذي يملأ الشاشة بأناقة واحترافية -->
        <Border Background="White" CornerRadius="16" Padding="40" Margin="30" 
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720" Width="680">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E1" Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel>

                <!-- عنوان الصفحة -->
                <TextBlock Text="Change Password" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                <TextBlock Text="Update your account security credentials safely" FontSize="13" Foreground="#64748B" Margin="0,0,0,20"/>

                <!-- ================= 1. بطاقة معلومات المستخدم المختصرة (داخل نفس البورد الكبير) ================= -->
                <TextBlock Text="Account Overview" FontSize="15" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>

                <Border Background="#F8FAFC" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- User ID -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="USER ID" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="🆔 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblUserID" Text="[????]" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Username -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="👤 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblUserName" Text="[????]" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 2. قسم إعدادات الأمان وكلمات المرور ================= -->
                <TextBlock Text="Security Settings" FontSize="15" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBlock Text="Please enter your current password and choose a secure new one." FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                <Separator Background="#E2E8F0" Height="1" Margin="0,0,0,20"/>

                <!-- Current Password -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="CURRENT PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <Grid Height="44">
                        <PasswordBox x:Name="txtCurrentPassword" Padding="12,0,40,0" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="txtCurrentPasswordVisible" Visibility="Collapsed" Padding="12,0,40,0" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnToggleCurrent" Content="👁️" Width="34" Height="34" HorizontalAlignment="Right" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" Click="btnToggleCurrent_Click" Cursor="Hand"/>
                    </Grid>
                </StackPanel>

                <!-- New Password -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="NEW PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <Grid Height="44">
                        <PasswordBox x:Name="txtNewPassword" Padding="12,0,40,0" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="txtNewPasswordVisible" Visibility="Collapsed" Padding="12,0,40,0" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnToggleNew" Content="👁️" Width="34" Height="34" HorizontalAlignment="Right" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" Click="btnToggleNew_Click" Cursor="Hand"/>
                    </Grid>
                </StackPanel>

                <!-- Confirm Password -->
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="CONFIRM PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <Grid Height="44">
                        <PasswordBox x:Name="txtConfirmPassword" Padding="12,0,40,0" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="txtConfirmPasswordVisible" Visibility="Collapsed" Padding="12,0,40,0" FontSize="14" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" VerticalContentAlignment="Center"/>
                        <Button x:Name="btnToggleConfirm" Content="👁️" Width="34" Height="34" HorizontalAlignment="Right" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" Click="btnToggleConfirm_Click" Cursor="Hand"/>
                    </Grid>
                </StackPanel>

                <!-- زر الحفظ بتصميم متناسق وبارز -->
                <Button x:Name="btnSave" Content="Save Changes" Height="48" Background="#2B6CB0" Foreground="White" FontWeight="Bold" FontSize="15" Cursor="Hand" Click="btnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2C5282"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>