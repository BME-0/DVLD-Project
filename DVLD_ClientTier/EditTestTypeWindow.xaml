<Window x:Class="DVLD_ClientTier.EditTestTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Test Type" Height="470" Width="526" Icon="H:\DVLD_Project\DVLD-Project\Icons\application.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F7F6" Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- العنوان -->
            <RowDefinition Height="*"/>
            <!-- المحتوى -->
            <RowDefinition Height="Auto"/>
            <!-- الأزرار -->
        </Grid.RowDefinitions>

        <!-- 1. العنوان -->
        <TextBlock Text="Update Test Type" FontSize="22" FontWeight="SemiBold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- 2. البطاقة البيضاء (تحتوي على الحقول بشكل مرتب) -->
        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,44,0,39" Grid.RowSpan="3">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <!-- ID -->
                <TextBlock Text="ID:" FontWeight="Medium" Foreground="#7F8C8D" FontSize="13"/>
                <TextBlock x:Name="lblTestTypeID" Text="[????]" FontWeight="Bold" Foreground="#2C3E50" FontSize="15" Margin="0,3,0,15"/>

                <!-- Title -->
                <TextBlock Text="Title:" FontWeight="Medium" Foreground="#34495E" FontSize="13"/>
                <TextBox x:Name="txtTitle" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,3,0,15" FontSize="14"/>

                <!-- Description -->
                <TextBlock Text="Description:" FontWeight="Medium" Foreground="#34495E" FontSize="13"/>
                <TextBox x:Name="txtDescription" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,3,0,15" FontSize="14"/>

                <!-- Fees -->
                <TextBlock Text="Fees ($):" FontWeight="Medium" Foreground="#34495E" FontSize="13"/>
                <TextBox x:Name="txtFees" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,3,0,0" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- 3. الأزرار -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnClose" Content="Cancel" Width="90" Height="34" Background="#EAECEE" Foreground="#34495E" FontWeight="Medium" BorderThickness="0" Cursor="Hand" Click="btnClose_Click" Margin="0,0,20,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="btnSave" Content="Save" Width="90" Height="34" Background="#2980B9" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="btnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>