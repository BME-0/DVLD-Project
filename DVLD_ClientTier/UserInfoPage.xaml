<Page x:Class="DVLD_ClientTier.UserInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DVLD_ClientTier"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="900"
      Title="User Information"
      Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- عنوان الصفحة -->
            <TextBlock Text="User Profile Details" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

            <!-- ================= 1. بطاقة معلومات تسجيل الدخول (Login Information) ================= -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- رأس البطاقة -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Login Information" FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                        <TextBlock Text="Basic system authentication and account details" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                        <Separator Background="#E2E8F0" Height="1" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- شبكة الحقول -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- User ID -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="USER ID" FontSize="10" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                            <Border Background="#F7FAFC" CornerRadius="8" Padding="10" Margin="0,4,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🆔" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblUserID" Text="[????]" FontSize="13" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Username -->
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                            <Border Background="#F7FAFC" CornerRadius="8" Padding="10" Margin="0,4,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblUserName" Text="[????]" FontSize="13" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Account Status -->
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="ACCOUNT STATUS" FontSize="10" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                            <Border Background="#F7FAFC" CornerRadius="8" Padding="10" Margin="0,4,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblIsActive" Text="[????]" FontSize="13" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= 2. بطاقة المعلومات الشخصية (Personal Information - بدون صورة) ================= -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- رأس البطاقة -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Personal Information" FontSize="16" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                            <TextBlock Text=" (Person ID: " FontSize="12" Foreground="#718096" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblPersonID" Text="N/A" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0" VerticalAlignment="Center"/>
                            <TextBlock Text=")" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Complete personal details and contact information" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                        <Separator Background="#E2E8F0" Height="1" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- حقول البيانات الشخصية بتصميم منظم ومنتشر -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- الصف الأول: الاسم الأول والاسم الثاني -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,6,8,6">
                            <TextBlock Text="👤 First Name" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblFirstName" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,6,0,6">
                            <TextBlock Text="👤 Second Name" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblSecondName" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- الصف الثاني: الاسم الثالث والاسم الأخير -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,8,6">
                            <TextBlock Text="👤 Third Name" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblThirdName" Text="—" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,6,0,6">
                            <TextBlock Text="👤 Last Name" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblLastName" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- الصف الثالث: الرقم الوطني وتاريخ الميلاد -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,8,6">
                            <TextBlock Text="💳 National No" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblNationalNo" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,6,0,6">
                            <TextBlock Text="📅 Date Of Birth / Age" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblDateOfBirthAndAge" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- الصف الرابع: الهاتف الأول والهاتف الثاني -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,6,8,6">
                            <TextBlock Text="📞 Phone 1" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblPhone1" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,6,0,6">
                            <TextBlock Text="📱 Phone 2" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblPhone2" Text="—" FontSize="12" Foreground="#718096" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- الصف الخامس: البريد الإلكتروني والجنس -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,6,8,6">
                            <TextBlock Text="✉️ Email Address" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblEmail" Text="—" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,6,0,6">
                            <TextBlock Text="🚻 Gender" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblGender" Text="N/A" FontSize="12" Foreground="#2D3748" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- الصف السادس: الدولة -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,6,8,6">
                            <TextBlock Text="🌐 Country" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblCountryName" Text="N/A" FontSize="12" Foreground="#4A5568" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- الصف السابع: العنوان الكامل (يمتد على العمودين معاً) -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,6">
                            <TextBlock Text="📍 Address" FontSize="10" Foreground="#A0AEC0" FontWeight="Bold"/>
                            <TextBlock x:Name="lblAddress" Text="N/A" FontSize="12" Foreground="#4A5568" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>