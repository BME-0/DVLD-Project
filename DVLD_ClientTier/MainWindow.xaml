<Window x:Class="DVLD_ClientTier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_ClientTier"
        mc:Ignorable="d"
        Title="DVLD - Driver &amp; Vehicle Licenses Department" 
        Height="800" Width="1300"
        Background="#F8FAFC"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Icon="H:\DVLD_Project\DVLD-Project\Icons\MainWindow.ico"
        Activated="Window_Activated">

    <!-- ================================================================= -->
    <!-- 1. موارد النافذة (WINDOW RESOURCES) - تعريف الألوان والاستايلات   -->
    <!-- ================================================================= -->
    <Window.Resources>

        <!-- لوحة الألوان الأساسية للنظام (SolidColorBrushes) -->
        <SolidColorBrush x:Key="SidebarBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="SidebarHeaderBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="HoverBg" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- استايل أزرار القائمة الجانبية (Menu Button Style) -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="5,2">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استايل الأزرار الدائرية (مثل زر الإشعارات والملف الشخصي) -->
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استايل القوائم القابلة للطي (Sidebar Expander Style) -->
        <Style x:Key="SidebarExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

    </Window.Resources>

    <!-- ================================================================= -->
    <!-- 2. التخطيط الرئيسي للنافذة (MAIN GRID LAYOUT)                     -->
    <!-- ================================================================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="762*"/>
            <RowDefinition Height="23*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Column 0: القائمة الجانبية -->
            <ColumnDefinition x:Name="SidebarColumn" Width="218.51"/>
            <ColumnDefinition Width="31.49"/>
            <!-- Column 1: منطقة المحتوى الرئيسية -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- 3. القائمة الجانبية (SIDEBAR - COLUMN 0)                         -->
        <!-- ================================================================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- ① هيدر القائمة الجانبية -->
                <Border Grid.Row="0" Background="{StaticResource SidebarHeaderBg}">
                    <Grid Margin="15,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- الشعار واسم النظام -->
                        <StackPanel x:Name="pnlLogoText" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="22" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DVLD SYSTEM" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="License Management" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- زر طي/فتح القائمة الجانبية -->
                        <Button Grid.Column="1" Content="☰" x:Name="btnToggleSidebar" 
                                Foreground="White" Background="Transparent" BorderThickness="0" 
                                FontSize="18" Cursor="Hand" VerticalAlignment="Center" Padding="5"
                                Click="btnToggleSidebar_Click"/>
                    </Grid>
                </Border>

                <!-- ② قائمة التنقل -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,15,10,10">

                        <Button Content="🏠    Dashboard" Style="{StaticResource MenuButtonStyle}" Click="btnDashboard_Click"/>

                        <Separator Background="#334155" Margin="5,10"/>

                        <!-- قائمة الطلبات والتراخيص القابلة للطي -->
                        <Expander Style="{StaticResource SidebarExpanderStyle}" Header="📄    Applications">
                            <StackPanel Margin="15,5,0,5">
                                <Button Content="• Local License" Style="{StaticResource MenuButtonStyle}" Click="btnLocalLicense_Click"/>
                                <Button Content="• International License" Style="{StaticResource MenuButtonStyle}" Click="btnInternationalLicense_Click"/>
                                <Button Content="• Renew License" Style="{StaticResource MenuButtonStyle}" Click="btnRenewLicense_Click"/>
                                <Button Content="• Replacement Licenses" Style="{StaticResource MenuButtonStyle}" Click="btnReplacementLicenses_Click"/>
                                <Button Content="• Manage App Types" Style="{StaticResource MenuButtonStyle}" Click="btnManageLocalApps_Click"/>
                                <Button Content="• Manage Test Types" Style="{StaticResource MenuButtonStyle}" Click="btnManageTestTypes_Click"/>
                                <Button Content="• Test Appointments" Style="{StaticResource MenuButtonStyle}" Click="btnTestAppointments_Click"/>
                                <Button Content="• Detained Licenses" Style="{StaticResource MenuButtonStyle}" Click="btnManageDetained_Click"/>
                                <Button Content="• Release Detained License" Style="{StaticResource MenuButtonStyle}" Click="btnReleaseDetainedLicense_Click"/>
                            </StackPanel>
                        </Expander>

                        <Button Content="👥    Manage People" Style="{StaticResource MenuButtonStyle}" Click="btnManagePeople_Click"/>
                        <Button Content="🚘    Drivers" Style="{StaticResource MenuButtonStyle}" Click="btnDrivers_Click"/>
                        <Button Content="🔐    Users" Style="{StaticResource MenuButtonStyle}" Click="btnUsers_Click"/>

                        <Separator Background="#334155" Margin="5,10"/>

                        <Expander Style="{StaticResource SidebarExpanderStyle}" Header="⚙️    Settings">
                            <StackPanel Margin="15,5,0,5">
                                <Button Content="👤 User Info" Style="{StaticResource MenuButtonStyle}" Click="btnCurrentUserInfo_Click"/>
                                <Button Content="🔑 Change Password" Style="{StaticResource MenuButtonStyle}" Click="btnChangePassword_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- ③ زر تسجيل الخروج السفلي -->
                <Button Grid.Row="2" Content="🚪    Sign Out" Style="{StaticResource MenuButtonStyle}" 
                        Background="#DC2626" Margin="10,10,10,0" Click="btnSignOut_Click" Height="42" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 4. منطقة المحتوى الرئيسي (MAIN CONTENT AREA - COLUMN 1)          -->
        <!-- ================================================================= -->
        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ① شريط الهيدر العلوي -->
            <Border Grid.Row="0" Background="White" Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtWelcomeUser" Text="👋 Welcome Back, Bassem" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="txtHeaderDate" Text="Friday, July 24, 2026" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" Width="340" Height="38" 
                            Background="#F1F5F9" CornerRadius="20" Padding="15,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" 
                                     VerticalAlignment="Center" Foreground="#334155" FontSize="13"
                                     Text="Search applications, people, drivers..."/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="38" Height="38" Style="{StaticResource CircularButtonStyle}" Margin="0,0,15,0">
                            <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#2563EB" Margin="0,0,10,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="txtUserEmoji" Text="👤" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="imgUserAvatar" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtTopUserName" Text="Bassem Mossad" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock x:Name="txtTopUserRole" Text="System Admin" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ② Frame لعرض الصفحات (Pages) أثناء التنقل -->
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

            <!-- ③ شريط الحالة السفلي للنظام -->
            <Border Grid.Row="2" Background="#0F172A">
                <Grid Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0"/>
                        <TextBlock Text="Connected to Database" Foreground="#94A3B8" FontSize="11" Margin="0,0,15,0"/>
                        <TextBlock Text="|" Foreground="#334155" FontSize="11" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtStatusRole" Text="Role: System Administrator" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Version 1.0.0" Foreground="#94A3B8" FontSize="11" Margin="0,0,15,0"/>
                        <TextBlock Text="|" Foreground="#334155" FontSize="11" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtStatusDate" Text="24 July 2026" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>