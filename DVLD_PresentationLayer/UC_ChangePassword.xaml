<UserControl x:Class="DVLD_PresentationLayer.UC_ChangePassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1050">

    <Border Background="White" CornerRadius="16" Padding="30" Margin="20" 
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
        <StackPanel>
            <TextBlock Text="🔒 Change Password" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Foreground="#1A202C"/>

            <!-- Current Password -->
            <TextBlock Text="Current Password" Foreground="#718096" Margin="0,0,0,5"/>
            <Grid Height="40" Margin="0,0,0,15">
                <PasswordBox x:Name="txtCurrentPassword" PreviewTextInput="TextBox_PreviewTextInput" VerticalContentAlignment="Center" Padding="10,0,35,0"/>
                <TextBox x:Name="txtCurrentPasswordVisible" Visibility="Collapsed" PreviewTextInput="TextBox_PreviewTextInput" VerticalContentAlignment="Center" Padding="10,0,35,0" BorderBrush="#FFABADB3"/>
                <Button x:Name="btnToggleCurrent" Content="👁️" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0" Background="Transparent" BorderBrush="Transparent" Click="btnToggleCurrent_Click" Cursor="Hand"/>
            </Grid>

            <!-- New Password -->
            <TextBlock Text="New Password" Foreground="#718096" Margin="0,0,0,5"/>
            <Grid Height="40" Margin="0,0,0,15">
                <PasswordBox x:Name="txtNewPassword" PreviewTextInput="TextBox_PreviewTextInput" VerticalContentAlignment="Center" Padding="10,0,35,0"/>
                <TextBox x:Name="txtNewPasswordVisible" Visibility="Collapsed" PreviewTextInput="TextBox_PreviewTextInput" VerticalContentAlignment="Center" Padding="10,0,35,0" BorderBrush="#FFABADB3"/>
                <Button x:Name="btnToggleNew" Content="👁️" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0" Background="Transparent" BorderBrush="Transparent" Click="btnToggleNew_Click" Cursor="Hand"/>
            </Grid>

            <!-- Confirm New Password -->
            <TextBlock Text="Confirm New Password" Foreground="#718096" Margin="0,0,0,5"/>
            <Grid Height="40" Margin="0,0,0,20">
                <PasswordBox x:Name="txtConfirmPassword" PreviewTextInput="TextBox_PreviewTextInput" VerticalContentAlignment="Center" Padding="10,0,35,0"/>
                <TextBox x:Name="txtConfirmPasswordVisible" Visibility="Collapsed" PreviewTextInput="TextBox_PreviewTextInput" VerticalContentAlignment="Center" Padding="10,0,35,0" BorderBrush="#FFABADB3"/>
                <Button x:Name="btnToggleConfirm" Content="👁️" Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0" Background="Transparent" BorderBrush="Transparent" Click="btnToggleConfirm_Click" Cursor="Hand"/>
            </Grid>

            <!-- زر الحفظ -->
            <Border CornerRadius="8" ClipToBounds="True" Height="45">
                <Button x:Name="btnSave" Content="Save Changes" 
                        Background="#3182CE" Foreground="White" 
                        FontWeight="Bold" Click="btnSave_Click"
                        BorderThickness="0"/>
            </Border>

        </StackPanel>
    </Border>
</UserControl>