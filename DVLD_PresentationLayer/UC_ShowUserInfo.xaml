<UserControl x:Class="DVLD_PresentationLayer.User_Controls.CtrlUserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.User_Controls"
             mc:Ignorable="d" 
             d:DesignWidth="800">

    <Border Background="White" CornerRadius="12" Padding="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Login Information" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#2D3748"/>
                <TextBlock Text="Basic system authentication and account details" 
                           FontSize="12" 
                           Foreground="#718096" 
                           Margin="0,2,0,0"/>
                <Separator Background="#E2E8F0" Height="1" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- User Info Details Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- User ID Field -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="USER ID" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                    <Border Background="#F7FAFC" CornerRadius="8" Padding="12" Margin="0,5,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🆔" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblUserID" Text="[????]" FontSize="14" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Username Field -->
                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                    <Border Background="#F7FAFC" CornerRadius="8" Padding="12" Margin="0,5,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblUserName" Text="[????]" FontSize="14" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Is Active Status Field -->
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="ACCOUNT STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                    <Border Background="#F7FAFC" CornerRadius="8" Padding="12" Margin="0,5,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblIsActive" Text="[????]" FontSize="14" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>