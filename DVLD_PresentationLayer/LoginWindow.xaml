<Window x:Class="DVLD_PresentationLayer.LoginWindow"        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVLD - Login"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F7FB"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Icon="H:\DVLD_Project\DVLD-Project\Icons\Login.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Banner / Branding Section -->
        <Border Grid.Column="0"
                Margin="20"
                CornerRadius="25"
                Background="#172554">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Orientation="Vertical">

                <!-- DVLD Car / Vehicle Icon Badge -->
                <Border Width="80"
                        Height="80"
                        CornerRadius="40"
                        Background="#1E3A8A"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <Grid>
                        <Path Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5H6.5C5.84 5 5.28 5.42 5.08 6.01L3 12V20C3 20.55 3.45 21 4 21H5C5.55 21 6 20.55 6 20V19H18V20C18 20.55 18.45 21 19 21H20C20.55 21 21 20.55 21 20V12L18.92 6.01M6.85 7H17.14L18.22 10.11H5.77L6.85 7M19 17H5V12.5H19V17M7.5 15C8.33 15 9 14.33 9 13.5S8.33 12 7.5 12 6 12.67 6 13.5 6.67 15 7.5 15M16.5 15C17.33 15 18 14.33 18 13.5S17.33 12 16.5 12 15 12.67 15 13.5 15.67 15 16.5 15Z"
                              Fill="White"
                              Width="38"
                              Height="38"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="DVLD"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="DRIVING &amp; VEHICLE"
                           Foreground="#CBD5E1"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBlock Text="LICENSE DEPARTMENT"
                           Foreground="#CBD5E1"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Version 1.0"
                           Foreground="#94A3B8"
                           FontSize="12"
                           Margin="0,30,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Right Login Form Section -->
        <Grid Grid.Column="1"
              Margin="50,40">

            <!-- Close Window Button -->
            <Button Content="✕"
                    Width="35"
                    Height="35"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#64748B"
                    FontSize="18"
                    Cursor="Hand"
                    Click="Close_Click"/>

            <StackPanel VerticalAlignment="Center"
                        Margin="0,20,0,0">

                <TextBlock Text="Welcome Back!"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Login to your account"
                           FontSize="15"
                           Foreground="#64748B"
                           Margin="0,8,0,30"/>

                <!-- Username Field -->
                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,8"/>
                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Background="#F8FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Username Icon -->
                        <TextBlock Text="👤"
                                   FontSize="16"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtUsername"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,15,0"
                                 FontSize="14"
                                 Foreground="#0F172A"/>
                    </Grid>
                </Border>

                <!-- Password Field -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,20,0,8"/>
                <Border Height="50"
                        CornerRadius="10"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Background="#F8FAFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lock Icon -->
                        <TextBlock Text="🔒"
                                   FontSize="14"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Password Inputs (PasswordBox & Visible TextBox overlapped) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <PasswordBox x:Name="txtPassword"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         Foreground="#0F172A"
                                         PasswordChanged="TxtPassword_PasswordChanged"/>

                            <TextBox x:Name="txtVisiblePassword"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     Visibility="Collapsed"
                                     TextChanged="TxtVisiblePassword_TextChanged"/>
                        </Grid>

                        <!-- Show/Hide Password Eye Button -->
                        <Button x:Name="btnShowHidePassword"
                                Grid.Column="2"
                                Content="👁"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#94A3B8"
                                FontSize="16"
                                Cursor="Hand"
                                Click="BtnShowHidePassword_Click"/>
                    </Grid>
                </Border>

                <!-- Remember Me Checkbox -->
                <CheckBox x:Name="chkRememberMe"
                          Content="Remember me"
                          Margin="0,20,0,25"
                          Foreground="#475569"
                          FontSize="13"/>

                <!-- Login Button -->
                <Button Content="LOGIN"
                        Height="50"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Window>