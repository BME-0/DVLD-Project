<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer"
        xmlns:Users="clr-namespace:DVLD_PresentationLayer.Users" 
        x:Class="DVLD_PresentationLayer.WPF_ShowUserWithDetails"
        mc:Ignorable="d"
        Title="Show User" Height="700" Width="950"
        WindowStartupLocation="CenterScreen" Icon="H:\DVLD_Project\DVLD-Project\Icons\ShowUser.ico" ResizeMode="NoResize">

    <!-- الـ Grid هنا سيعمل كحاوية رئيسية تمتلئ بالكامل داخل الـ Window -->
    <Grid>

        <!-- 
           التعديلات هنا:
           1. إزالة HorizontalAlignment="Left" والـ Margin الثابت القديم.
           2. جعل الـ UserControl يمتد ليغطي مساحة الـ Grid بالكامل (HorizontalAlignment="Stretch" و VerticalAlignment="Stretch").
           3. وضع Margin بسيط (إن أردت) لترك مسافة إطارية خفيفة تتماشى مع تصميم الكارت الداخلي.
        -->
        <Users:UC_ShowUserWithDetails 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch" 
            Margin="10" x:Name="UserCard"/>

    </Grid>
</Window>