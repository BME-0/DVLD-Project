<UserControl 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.Users"
             xmlns:uc="clr-namespace:DVLD_PresentationLayer.User_Controls"
             xmlns:DVLD_PresentationLayer="clr-namespace:DVLD_PresentationLayer" 
             x:Class="DVLD_PresentationLayer.Users.UC_ShowUserWithDetails"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1050"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <!-- ScrollViewer لحل مشاكل التكبير والتصغير ومنع تشوه العناصر تماماً -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent">

        <!-- 
            التعديلات هنا:
            1. VerticalAlignment="Top": لكي يبدأ الكارت من أعلى الشاشة وليس المنتصف.
            2. HorizontalAlignment="Stretch": لكي يتمدد ويأخذ العرض المتاح.
            3. MaxWidth="900": لكي نحجم التمدد ولا يبدو الكارت ممطوطاً جداً على الشاشات الكبيرة.
            4. زيادة الـ Margin من الأعلى إلى 30 ليعطي تنفساً للشاشة.
        -->
        <Border Background="#F8FAFC" CornerRadius="16" Padding="25" Margin="15,30,15,15" 
                HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxWidth="900" Height="690"  Width="1050">
            <Border.Effect>
                <DropShadowEffect Color="#CBD5E0" Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Title Bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="User Comprehensive Profile" FontSize="20" FontWeight="Bold" Foreground="#1A202C" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 2. Person Information Card (كارت الشخص في الأعلى) -->
                <!-- التعديل: HorizontalAlignment="Stretch" لكي يملأ الكارت الداخلي مساحة الـ Border بالكامل -->
                <DVLD_PresentationLayer:UC_PersonCard x:Name="PersonCard" Grid.Row="1" 
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,15"/>

                <!-- 3. Login / User Credentials Information Control (تحته مباشرة) -->
                <!-- التعديل: HorizontalAlignment="Stretch" لكي يتساوى في العرض مع الكارت الأعلى منه -->
                <uc:CtrlUserCard x:Name="UserCard" Grid.Row="2" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>