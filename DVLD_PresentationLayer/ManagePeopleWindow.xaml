<Window x:Name="Frm_ManagePeople" x:Class="DVLD.ManagePeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="People Directory" Height="880" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Loaded="Window_Loaded" Icon="/ManagePeople.ico"
        WindowState="Normal"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Style الأزرار الرئيسية (Blue Primary) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style الأزرار الثانوية (Secondary / Close) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style أزرار العمليات السريعة داخل الجدول (Action Buttons) -->
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style أزرار الـ Pagination -->
        <Style x:Key="PageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style هيدر الجدول -->
        <Style x:Key="ModernColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <!-- Style صفوف الجدول -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Section -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Search -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer & Pagination -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="People Directory" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Manage, search and edit system users &amp; profiles" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                    <Button x:Name="btnAddNewPerson" Content="➕ Add Person" Style="{StaticResource PrimaryButtonStyle}" Click="btnAddNewPerson_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dashboard Cards (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👥 Total People" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="lblTotalPeopleCard" Text="1,250" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Male -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👨 Male" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB"/>
                    <TextBlock x:Name="lblMaleCard" Text="780" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Female -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👩 Female" FontSize="13" FontWeight="SemiBold" Foreground="#EC4899"/>
                    <TextBlock x:Name="lblFemaleCard" Text="470" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Nationalities -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🌍 Countries" FontSize="13" FontWeight="SemiBold" Foreground="#10B981"/>
                    <TextBlock x:Name="lblCountriesCard" Text="15" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Search & Filter Bar Section -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="198.833"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,0,1021,0">
                    <TextBlock Text="Filter By:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0,10,0"/>
                    <ComboBox x:Name="cbFilterBy" Width="150" Height="34" VerticalContentAlignment="Center" 
                              SelectionChanged="cbFilterBy_SelectionChanged" Padding="8,0" Background="#F8FAFC">
                        <ComboBoxItem Content="None" IsSelected="True"/>
                        <ComboBoxItem Content="Person ID"/>
                        <ComboBoxItem Content="National No"/>
                        <ComboBoxItem Content="First Name"/>
                        <ComboBoxItem Content="Second Name"/>
                        <ComboBoxItem Content="Third Name"/>
                        <ComboBoxItem Content="Last Name"/>
                        <ComboBoxItem Content="Gender"/>
                        <ComboBoxItem Content="Nationality"/>
                        <ComboBoxItem Content="Phone 1"/>
                        <ComboBoxItem Content="Email"/>
                    </ComboBox>
                </StackPanel>

                <!-- Big Search Box -->
                <Grid Grid.Column="2" Margin="16,0,0,0">
                    <TextBox x:Name="txtFilterValue" Height="34" VerticalContentAlignment="Center" 
                             Padding="30,0,10,0" Background="#F8FAFC" BorderBrush="#CBD5E1" 
                             BorderThickness="1" TextChanged="txtFilterValue_TextChanged"
                             PreviewTextInput="txtFilterValue_PreviewTextInput"
                             PreviewKeyDown="txtFilterValue_PreviewKeyDown"/>
                    <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="#94A3B8" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. DataGrid Section -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000000"/>
            </Border.Effect>

            <DataGrid x:Name="dgvPeople" AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                      Background="Transparent" BorderThickness="0" SelectionMode="Single"
                      RowBackground="White" AlternatingRowBackground="#F8FAFC">

                <!-- Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu FontSize="13">
                        <MenuItem Header="👁 Show Details" Click="cmShowDetails_Click"/>
                        <Separator/>
                        <MenuItem Header="➕ Add New Person" Click="cmAddNewPerson_Click"/>
                        <MenuItem Header="✏ Edit Person" Click="cmEditPerson_Click"/>
                        <MenuItem Header="🗑 Delete Person" Click="cmDeletePerson_Click"/>
                        <Separator/>
                        <MenuItem Header="📧 Send Email" Click="cmSendEmail_Click"/>
                        <MenuItem Header="📞 Phone Call" Click="cmPhoneCall_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- 1. Photo Column -->
                    <DataGridTemplateColumn Header="Photo" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- البيانات الأساسية -->
                    <DataGridTextColumn Header="Person ID" Binding="{Binding PersonID}" Width="85"/>
                    <DataGridTextColumn Header="National No" Binding="{Binding NationalNo}" Width="100"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="95"/>
                    <DataGridTextColumn Header="Second Name" Binding="{Binding SecondName}" Width="95"/>
                    <DataGridTextColumn Header="Third Name" Binding="{Binding ThirdName}" Width="95"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="95"/>
                    <DataGridTextColumn Header="Gender" Binding="{Binding GendorCaption}" Width="75"/>
                    <DataGridTextColumn Header="Date Of Birth" Binding="{Binding DateOfBirth, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100"/>
                    <DataGridTextColumn Header="Nationality" Binding="{Binding CountryName}" Width="105"/>
                    <DataGridTextColumn Header="Phone 1" Binding="{Binding Phone1}" Width="100"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="130"/>

                    <!-- 2. Actions Column -->
                    <DataGridTemplateColumn Header="Actions" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁" Style="{StaticResource RowActionButtonStyle}" ToolTip="View Details" Click="cmShowDetails_Click"/>
                                    <Button Content="✏" Style="{StaticResource RowActionButtonStyle}" ToolTip="Edit" Click="cmEditPerson_Click"/>
                                    <Button Content="🗑" Style="{StaticResource RowActionButtonStyle}" ToolTip="Delete" Click="cmDeletePerson_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Footer & Pagination Section (تعديل كامل) -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Record Counter & Page Size Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E2E8F0" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Records: " FontSize="13" FontWeight="Medium" Foreground="#475569"/>
                        <TextBlock x:Name="lblRecordsCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- ComboBox لتحديد عدد العناصر بالصفحة -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Page Size:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cbPageSize" Width="60" Height="30" VerticalContentAlignment="Center" 
                              SelectionChanged="cbPageSize_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Pagination Control Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnFirst" Content="⏮" Style="{StaticResource PageButtonStyle}" Margin="2,0" Padding="8,5" Click="btnFirst_Click" ToolTip="First Page"/>
                <Button x:Name="btnPrevious" Content="◀ Previous" Style="{StaticResource PageButtonStyle}" Margin="2,0" Click="btnPrevious_Click"/>

                <!-- مؤشر الصفحة الحالية -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,5" Margin="4,0">
                    <TextBlock x:Name="lblPageInfo" Text="Page 1 of 1" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </Border>

                <Button x:Name="btnNext" Content="Next ▶" Style="{StaticResource PageButtonStyle}" Margin="2,0" Click="btnNext_Click"/>
                <Button x:Name="btnLast" Content="⏭" Style="{StaticResource PageButtonStyle}" Margin="2,0" Padding="8,5" Click="btnLast_Click" ToolTip="Last Page"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="btnClose_Click"/>
        </Grid>
    </Grid>
</Window>