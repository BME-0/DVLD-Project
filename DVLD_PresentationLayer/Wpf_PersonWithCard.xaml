<Window x:Class="DVLD_PresentationLayer.Wpf_PersonWithCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer"
        mc:Ignorable="d"
        Title="Wpf_PersonWithCard" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F8FAFC">
        <!-- تم إزالة الهوامش الثابتة وضبطه ليتموضع في منتصف الشاشة تلقائياً مهما تغير حجم النافذة -->
        <local:UC_PersonCardWithFilter x:Name="UC_PersonWithFilter" 
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"/>
    </Grid>
</Window>